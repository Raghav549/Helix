{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": ".build",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": false,
    "esModuleInterop": true
  },
  "include": [
    "src/lib/**/*.ts",
    "tests/**/*.ts"
  ]
}
