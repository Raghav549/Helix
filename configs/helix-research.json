{
  "model": {
    "vocab_size": 512,
    "block_size": 128,
    "n_layer": 3,
    "n_head": 4,
    "n_embd": 128,
    "n_kv_head": 2,
    "dropout": 0.1,
    "bias": false,
    "eps": 0.00001,
    "rope_base": 10000.0,
    "weight_tying": true,
    "grad_checkpoint": false,
    "block_type": "transformer"
  },
  "train": {
    "batch_size": 8,
    "block_size": 128,
    "max_iters": 1800,
    "eval_interval": 150,
    "eval_iters": 20,
    "learning_rate": 0.0006,
    "weight_decay": 0.05,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "gradient_accumulation_steps": 1,
    "lr_decay_iters": 1800,
    "min_lr": 0.00006,
    "warmup_iters": 50,
    "seed": 1337,
    "device": "cpu",
    "dtype": "float32",
    "log_interval": 150,
    "save_interval": 0,
    "out_dir": "artifacts/llm",
    "resume_from": null
  },
  "data": {
    "train_file": "artifacts/data/train.npy",
    "val_file": "artifacts/data/val.npy",
    "vocab_file": "artifacts/data/vocab.json",
    "merges_file": "artifacts/data/merges.json",
    "corpus_file": "artifacts/data/corpus.txt",
    "train_frac": 0.9
  }
}
