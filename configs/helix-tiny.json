{
  "model": {
    "vocab_size": 800,
    "block_size": 128,
    "n_layer": 2,
    "n_head": 4,
    "n_embd": 128,
    "n_kv_head": 2,
    "dropout": 0.1,
    "bias": false,
    "eps": 1e-5,
    "rope_base": 10000.0,
    "weight_tying": true,
    "grad_checkpoint": false
  },
  "train": {
    "batch_size": 8,
    "block_size": 128,
    "max_iters": 300,
    "eval_interval": 60,
    "eval_iters": 20,
    "learning_rate": 1e-3,
    "weight_decay": 1e-1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "gradient_accumulation_steps": 1,
    "lr_decay_iters": 300,
    "min_lr": 1e-4,
    "warmup_iters": 20,
    "seed": 1337,
    "device": "cpu",
    "dtype": "float32",
    "log_interval": 25,
    "save_interval": 250,
    "out_dir": "out/tiny-run",
    "resume_from": null
  },
  "data": {
    "train_file": "data/train.npy",
    "val_file": "data/val.npy",
    "vocab_file": "data/vocab.json",
    "merges_file": "data/merges.json",
    "corpus_file": "data/seed_corpus.txt",
    "train_frac": 0.9
  }
}
