{
  "model": {
    "vocab_size": 800,
    "block_size": 256,
    "n_layer": 6,
    "n_head": 8,
    "n_embd": 256,
    "n_kv_head": 4,
    "dropout": 0.1,
    "bias": false,
    "eps": 1e-5,
    "rope_base": 10000.0,
    "weight_tying": true,
    "grad_checkpoint": false,
    "block_type": "transformer",
    "window_size": 64,
    "rope_scaling": "ntk",
    "ntk_alpha": 1.0,
    "max_position_embeddings": 1024
  },
  "train": {
    "batch_size": 4,
    "block_size": 256,
    "max_iters": 300,
    "eval_interval": 60,
    "eval_iters": 15,
    "learning_rate": 6e-4,
    "weight_decay": 1e-1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "gradient_accumulation_steps": 1,
    "lr_decay_iters": 300,
    "min_lr": 6e-5,
    "warmup_iters": 30,
    "seed": 1337,
    "device": "cpu",
    "dtype": "float32",
    "log_interval": 25,
    "save_interval": 0,
    "out_dir": "out/long-context-ntk-run",
    "resume_from": null
  },
  "data": {
    "train_file": "data/train.npy",
    "val_file": "data/val.npy",
    "vocab_file": "data/vocab.json",
    "merges_file": "data/merges.json",
    "corpus_file": "data/seed_corpus.txt",
    "train_frac": 0.9
  }
}
